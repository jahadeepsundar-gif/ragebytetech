# RageByte Environment Variables

# Resend API Key for contact form email delivery
# Obtain an API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# RageByte inbox address where enquiries should be received
CONTACT_RECEIVER_EMAIL=hello@ragebyte.tech

# Verified sender address configured in Resend (defaults to onboarding@resend.dev during development)
CONTACT_SENDER_EMAIL="RageByte Enquiries <onboarding@resend.dev>"

# Public site URL for metadata and OpenGraph resolution
NEXT_PUBLIC_SITE_URL=https://ragebyte.tech
